# ────────── Spring ──────────
SPRING_PROFILES_ACTIVE=local
SPRING_PORT=8080

# ────────── MySQL ──────────
MYSQL_DB_HOST=localhost
MYSQL_DB_PORT=3306
MYSQL_DB_NAME=home_risk_check
MYSQL_DB_USERNAME=your_username
MYSQL_DB_PASSWORD=your_password

# ────────── Redis ──────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_password

# ────────── Security ──────────
BCRYPT_STRENGTH=12

# ────────── CORS ──────────
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ────────── AWS S3 ──────────
# 로컬: 아래 환경변수 또는 ~/.aws/credentials 사용
# 운영: IAM Role 권장 (AWS_ACCESS_KEY_ID/SECRET_ACCESS_KEY 미사용)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=your_bucket_name
AWS_S3_UPLOAD_PREFIX=images
FILE_BASE_URL=https://your_bucket.s3.ap-northeast-2.amazonaws.com

# ────────── External APIs ──────────
KAKAO_REST_API_KEY=your_kakao_key
TAAS_API_KEY=your_taas_key
PUBLIC_DATA_SERVICE_KEY=your_public_data_key

# ────────── FastAPI (위험도 분석 서버) ──────────
FASTAPI_BASE_URL=http://localhost:8000

# ────────── 메일 (이메일 인증 SMTP) ──────────
# 예) Naver: smtp.naver.com / 587, Gmail: smtp.gmail.com / 587
MAIL_HOST=smtp.your-provider.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_smtp_password
MAIL_FROM=your_email@example.com

# ────────── JWT 키 경로 (운영 전용) ──────────
# 운영에서 JAR 내부 keys/ 대신 외부 디스크 경로 사용 시 설정
# JWT_PRIVATE_KEY_PATH=file:/etc/secrets/privatekey.pem
# JWT_PUBLIC_KEY_PATH=file:/etc/secrets/publickey.pem
